pkgname=umtp-responder
pkgver=1.9.1
pkgrel=3
_commit=153f76d65608c184a972ad7d0b4ae605e56c0972
_upstream=uMTP-Responder
pkgdesc='Lightweight Media Transfer Protocol (MTP) responder daemon'
arch=(aarch64)
url='https://github.com/viveris/uMTP-Responder'
license=(GPL-3.0-or-later)
depends=(glibc systemd-libs)
makedepends=(gcc make systemd)
backup=(etc/umtprd/umtprd.conf)
source=("${pkgname}-${_commit}.tar.gz::${url}/archive/${_commit}.tar.gz")
sha256sums=(SKIP)

_patches=()
for _p in "${startdir}"/patch-set/*.patch; do
  [ -e "${_p}" ] && _patches+=("$(basename "${_p}")")
done
unset _p

prepare() {
  cd "${_upstream}-${_commit}"

  [ ${#_patches[@]} -gt 0 ] || {
    echo "::  no patches in ${startdir}/patch-set -- run scripts/fetch-patch-set.sh umtp-responder"
    echo "::  refusing to build: without armada's five patches this is stock"
    echo "::  uMTP-Responder at an armada-pinned commit, which they do not ship."
    return 1
  }
  local p f
  for p in "${_patches[@]}"; do
    f="${startdir}/patch-set/${p}"
    [ -f "${f}" ] || { echo "::  missing patch: ${p} (run scripts/fetch-patch-set.sh ${pkgname})"; return 1; }
    if ! patch -p1 --batch --forward -F0 --dry-run --quiet < "${f}"; then
      echo "::  FAILED: ${p}"
      echo "::  armada rebased onto a different upstream commit, or _commit moved."
      return 1
    fi
    patch -p1 --batch --forward -F0 --quiet < "${f}"
    echo "::  applied: ${p}"
  done
}

build() {
  cd "${_upstream}-${_commit}"
  make \
    CFLAGS="${CFLAGS} -I./inc -Wall -DSYSTEMD_NOTIFY" \
    LDFLAGS="${LDFLAGS} -lpthread -lrt -lsystemd"
}

package() {
  cd "${_upstream}-${_commit}"
  install -Dm755 umtprd "${pkgdir}/usr/bin/umtprd"
  install -Dm644 conf/umtprd.conf "${pkgdir}/etc/umtprd/umtprd.conf"
  install -Dm644 LICENSE "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
  install -Dm644 README.md "${pkgdir}/usr/share/doc/${pkgname}/README.md"
}
