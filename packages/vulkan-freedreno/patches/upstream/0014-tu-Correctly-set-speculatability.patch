       nir_def *bindless =
-         nir_bindless_resource_ir3(b, 32, descriptor_idx, .desc_set = nir_scalar_as_uint(scalar_idx));
+         bindless_resource_ir3(b, nir_scalar_as_uint(scalar_idx),
