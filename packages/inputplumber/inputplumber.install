post_install() {
    cat <<'MSG'
inputplumber is installed but not enabled. To start it:

    systemctl enable --now inputplumber.service

It grabs input devices exclusively, so enable it only where you want it
mediating the controller.
MSG
}

post_upgrade() {
    udevadm control --reload-rules 2>/dev/null || true
    udevadm hwdb --update 2>/dev/null || true
}
