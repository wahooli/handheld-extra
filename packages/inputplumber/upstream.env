# InputPlumber -- the input router that makes handheld controllers, gyros and
# back-buttons present themselves as something Steam understands. armada pins an
# exact upstream commit and carries three fixes on top.
#
# ── why this is no longer TRACK=oci ──────────────────────────────────────────
#
# armada-os/armada-packages was ARCHIVED on 2026-09-18 and its contents moved
# into armada-os/armada under packages/. The OCI artifacts went with it: the new
# repo tags package images by CONTENT HASH and publishes no `latest`, so there is
# nothing to resolve a version from and no sha embedded in a tag to read the
# patch set at. The old images still resolve, frozen, and would have gone on
# reporting "up to date" forever.
#
# The commit is the release now. The old comment here argued for the artifact
# over the git history, because armada could rebuild with nothing changed under
# inputplumber/ and a directory watch would call that "up to date". That concern
# inverts once the artifact is gone: we never consumed their image, we build from
# the same sources ourselves, so a rebuild that changes nothing we read is
# genuinely nothing to do. TRACK_PATHS therefore lists what this package actually
# consumes -- their patches and their BASE.env -- and an edit to their build.sh
# or spec is correctly invisible.
TRACK=github-paths
GITHUB_REPO=armada-os/armada
TRACK_PATHS="packages/inputplumber/patches packages/inputplumber/BASE.env"

# The patch set, read at the tracked commit. PATCHES_REF is unset: CURRENT is
# already the git ref, which is the default.
PATCHES_REPO=armada-os/armada
PATCHES_PATH=packages/inputplumber

CURRENT=956bd2c73e612e9a42ceedc558caafa79fb5456a

# pkgver and _commit come from armada's BASE.env at that same commit: they pin an
# exact upstream commit and their patches are written against it.
VERSION_FROM=repo-file
VERSION_FILE=packages/inputplumber/BASE.env
