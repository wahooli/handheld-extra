     }
 }
 
+/// Wait until `fd` is readable or `timeout` has passed. False if poll failed or
+/// the descriptor reports an error or hangup, so the caller sleeps as before
+/// instead of spinning on a dead device.
+fn wait_readable(fd: RawFd, timeout: Duration) -> bool {
+    use nix::libc::{poll, pollfd, POLLERR, POLLHUP, POLLIN, POLLNVAL};
+    let mut pfd = pollfd {
+        fd,
+        events: POLLIN,
+        revents: 0,
+    };
+    let ms = timeout.as_millis().min(i32::MAX as u128) as i32;
+    // SAFETY: one valid pollfd that outlives the call.
+    let ret = unsafe { poll(&mut pfd, 1, ms) };
+    ret >= 0 && pfd.revents & (POLLERR | POLLHUP | POLLNVAL) == 0
+}
