+
+/// What an idle source waits on, from [SourceInputDevice::idle_wait].
+pub enum IdleWait {
+    /// Keep polling: input arrives without a descriptor to wait on, or
+    /// something is scheduled.
+    Poll,
+    /// A descriptor that becomes readable when the device has input, and that
+    /// [SourceInputDevice::poll] drains.
+    Fd(RawFd),
+    /// Output only, with nothing scheduled: only commands can make work.
+    Commands,
 }
 
 /// A [SourceOutputDevice] is a device implementation that can handle output events
@@ -394,6 +419,7 @@ impl<T: SourceInputDevice + SourceOutputDevice + Send + 'static> SourceDriver<T>
