-                    if let Err(e) = SourceDriver::receive_commands(
+                    match SourceDriver::receive_commands(
                         &mut rx,
                         &mut implementation,
                         &mut event_filter,
                     ) {
-                        log::debug!("Error receiving commands: {:?}", e);
-                        break;
+                        Ok(true) => last_active = Instant::now(),
+                        Ok(false) => (),
+                        Err(e) => {
+                            log::debug!("Error receiving commands: {:?}", e);
+                            break;
+                        }
+                    }
+
+                    // Idle: sleep until the device has input, for at most
+                    // IDLE_WAIT, rather than waking every poll_rate for nothing.
+                    if last_active.elapsed() >= IDLE_AFTER {
+                        match implementation.idle_wait() {
+                            IdleWait::Fd(fd) => {
+                                if wait_readable(fd, IDLE_WAIT) {
+                                    continue;
+                                }
+                            }
+                            IdleWait::Commands => {
+                                thread::sleep(IDLE_WAIT);
+                                continue;
+                            }
+                            IdleWait::Poll => (),
+                        }
                     }
 
                     let poll_time = poll_time_start.elapsed();
@@ -490,12 +540,12 @@ impl<T: SourceInputDevice + SourceOutputDevice + Send + 'static> SourceDriver<T>
     }
 
     /// Read commands sent to this device from the channel until it is
-    /// empty.
+    /// empty. Returns whether there were any.
     fn receive_commands(
         rx: &mut mpsc::Receiver<SourceCommand>,
         implementation: &mut MutexGuard<'_, T>,
         event_filter: &mut HashSet<Capability>,
-    ) -> Result<(), Box<dyn Error>> {
+    ) -> Result<bool, Box<dyn Error>> {
         const MAX_COMMANDS: u8 = 64;
         let mut commands_processed = 0;
         loop {
@@ -554,7 +604,7 @@ impl<T: SourceInputDevice + SourceOutputDevice + Send + 'static> SourceDriver<T>
                     }
                 },
