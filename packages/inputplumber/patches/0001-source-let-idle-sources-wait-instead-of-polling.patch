@@ -420,6 +446,9 @@ impl<T: SourceInputDevice + SourceOutputDevice + Send + 'static> SourceDriver<T>
                         let poll_span = context.metrics_mut().get_mut("source_poll").unwrap();
                         poll_span.finish();
                     }
