pkgname=inputplumber
pkgver=0.79.0
pkgrel=2
_commit=1822d1e7cd319708c96b7f7b37b566c96c5de1d4
_appname=InputPlumber
pkgdesc='Input router and remapper daemon for handheld gaming devices'
arch=(aarch64)
url='https://github.com/ShadowBlip/InputPlumber'
license=(GPL-3.0-or-later)
depends=(glibc systemd-libs dbus libevdev libiio)
makedepends=(cargo rust clang lld make git)
install=inputplumber.install
source=("${pkgname}-${_commit}.tar.gz::${url}/archive/${_commit}.tar.gz")
sha256sums=(SKIP)

_patches=()
for _p in "${startdir}"/patch-set/*.patch; do
  [ -e "${_p}" ] && _patches+=("$(basename "${_p}")")
done
unset _p

prepare() {
  cd "${_appname}-${_commit}"

  [ ${#_patches[@]} -gt 0 ] || {
    echo "::  no patches in ${startdir}/patch-set -- run scripts/fetch-patch-set.sh inputplumber"
    echo "::  refusing to build: without armada's fixes this is stock InputPlumber"
    echo "::  at an armada-pinned commit -- a combination nobody has tested."
    return 1
  }
  local p f
  for p in "${_patches[@]}"; do
    f="${startdir}/patch-set/${p}"
    [ -f "${f}" ] || { echo "::  missing patch: ${p} (run scripts/fetch-patch-set.sh ${pkgname})"; return 1; }
    if ! patch -p1 --batch --forward -F0 --dry-run --quiet < "${f}"; then
      echo "::  FAILED: ${p}"
      echo "::  armada rebased onto a different upstream commit, or _commit moved."
      return 1
    fi
    patch -p1 --batch --forward -F0 --quiet < "${f}"
    echo "::  applied: ${p}"
  done

  export RUSTUP_TOOLCHAIN=stable
  cargo fetch --locked --target aarch64-unknown-linux-gnu
}

build() {
  cd "${_appname}-${_commit}"
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target
  make build BUILD_TYPE=release
}

package() {
  cd "${_appname}-${_commit}"
  make install PREFIX="${pkgdir}/usr"
  install -Dm644 LICENSE "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
  install -Dm644 README.md "${pkgdir}/usr/share/doc/${pkgname}/README.md"
}
