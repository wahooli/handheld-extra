# The dev branch, not releases: 1.0.10, the latest release (2025-08), only talks
# to EmuDeck's Python backend (backend/api.py, tools/wrappers/). The arm64
# EmuDeck 2.6.1 app installs the bash backend, where every EmuDecky toggle did
# nothing; dev (2026-09) translates them for it ("LEGACY" mode in main.py).
#
# Releases are sparse, so this follows the branch head like lsfg-vk-git: the
# version is `<commit date>.<sha8>`. Going back to a release tag later needs an
# epoch, since 1.0.x sorts below a date.
TRACK=git-branch
GIT_URL=https://github.com/EmuDeck/EmuDecky.git
GIT_BRANCH=dev
CURRENT=8d6b98b1ad05c9473ad1a1a7bf99f7b7503d18ae
VERSION_FROM=commit-date
