pkgname=decky-plugin-emudecky
pkgver=20260920.8d6b98b1
pkgrel=1
_commit=8d6b98b1ad05c9473ad1a1a7bf99f7b7503d18ae
pkgdesc="EmuDeck's official Decky plugin (EmuDecky), built for aarch64"
arch=('aarch64')
url='https://github.com/EmuDeck/EmuDecky'
license=('GPL-2.0-or-later')
depends=()
makedepends=('git' 'nodejs' 'npm' 'pnpm')
source=("git+${url}.git#commit=${_commit}")
sha256sums=('SKIP')

_srcdir="EmuDecky"

_patches=(
  0001-main-skip-the-cloud-status-poll-when-there-is-nothing-to-ask.patch
  0002-update-emulators-run-binupdate-on-the-bash-backend.patch
)

prepare() {
    cd "${srcdir}/${_srcdir}"

    local p f
    for p in "${_patches[@]}"; do
        f="${startdir}/patches/${p}"
        [ -f "${f}" ] || { echo "::  missing patch: ${p}"; return 1; }
        if ! patch -p1 --batch --forward -F0 --dry-run --quiet < "${f}"; then
            echo "::  FAILED: ${p}"
            echo "::  EmuDecky moved under the patch — rebase it against ${_commit:0:8}."
            return 1
        fi
        patch -p1 --batch --forward -F0 --quiet < "${f}"
        echo "::  applied: ${p}"
    done

    # upstream's package.json lags (1.0.8 at the 1.0.10 tag, 1.0.11 on dev), and
    # decky-sync reseeds ~/homebrew/plugins only when this version is newer:
    # without our own, a rebuilt package never reaches a device that has the plugin.
    sed -i -E "s/(\"version\": *\")[^\"]*\"/\1${pkgver}-${pkgrel}\"/" package.json
    grep -q "\"version\": *\"${pkgver}-${pkgrel}\"" package.json \
        || { echo "::  package.json version was not set"; return 1; }
}

build() {
    cd "${srcdir}/${_srcdir}"

    export HOME="${srcdir}/.home"
    export XDG_CACHE_HOME="${srcdir}/.cache"
    export npm_config_cache="${srcdir}/.npm"
    export PNPM_HOME="${srcdir}/.pnpm"
    mkdir -p "${HOME}" "${XDG_CACHE_HOME}" "${PNPM_HOME}"

    pnpm i --dangerously-allow-all-builds
    pnpm run build

    [ -f dist/index.js ] \
        || { echo "PKGBUILD: rollup produced no dist/index.js" >&2; return 1; }
}

package() {
    cd "${srcdir}/${_srcdir}"

    local dest="${pkgdir}/usr/share/decky-plugins/EmuDecky"
    install -d "${dest}"

    install -Dm0644 plugin.json package.json -t "${dest}/"
    install -Dm0644 main.py -t "${dest}/"

    cp -a dist "${dest}/dist"
    rm -f "${dest}/dist/"*.map

    if [ -d py_modules ]; then
        cp -a py_modules "${dest}/py_modules"
    else
        install -d "${dest}/py_modules"
    fi
    [ -d assets ] && cp -a assets "${dest}/assets"

    find "${dest}" -name __pycache__ -type d -prune -exec rm -rf {} +

    install -Dm0644 LICENSE "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
}
