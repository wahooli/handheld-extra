From: handheld-extra
Subject: [PATCH] steamcompmgr: run Steam's UI at the panel's preferred rate

With no game focused, gamescope runs the panel at the highest rate it can
switch to. That is Valve's own panels' preferred rate anyway (60 Hz on the Deck
LCD, 90 on the OLED), but the AYANEO Pocket VERT's panel offers 60-120 Hz with
60 preferred, and so Steam's menus ran at 120 Hz: twice the scan-out for a UI
that does not need it, and at 120 Hz its rotated composite also needs a raised
GPU floor to keep up.

The new refresh_ui_preferred ConVar (on by default) uses the connector's
preferred mode instead whenever no game decides the rate, unless VRR is active.
A focused game keeps its own rate and limits. Set it to 0 for upstream's
choice.

---
--- a/src/backend.h
+++ b/src/backend.h
@@ -190,6 +190,8 @@ namespace gamescope
 
         virtual std::span<const uint8_t> GetRawEDID() const = 0;
         virtual std::span<const uint32_t> GetValidDynamicRefreshRates() const = 0;
+        // The rate of the display's preferred mode, 0 when there is none.
+        virtual uint32_t GetPreferredRefreshRate() const { return 0; }
 
         virtual void GetNativeColorimetry(
             bool bHDR10,
--- a/src/Backends/DRMBackend.cpp
+++ b/src/Backends/DRMBackend.cpp
@@ -455,6 +455,7 @@ namespace gamescope
 		const char *GetDataString() const { return m_Mutable.szDataString; }
 		uint32_t GetPossibleCRTCMask() const { return m_Mutable.uPossibleCRTCMask; }
 		std::span<const uint32_t> GetValidDynamicRefreshRates() const override { return m_Mutable.ValidDynamicRefreshRates; }
+		uint32_t GetPreferredRefreshRate() const override;
 		const displaycolorimetry_t& GetDisplayColorimetry() const { return m_Mutable.DisplayColorimetry; }
 
 		std::span<const uint8_t> GetRawEDID() const override { return std::span<const uint8_t>{ m_Mutable.EdidData.begin(), m_Mutable.EdidData.end() }; }
@@ -3291,6 +3292,13 @@ namespace gamescope
 		}
 	}
 
+	uint32_t CDRMConnector::GetPreferredRefreshRate() const
+	{
+		// The kernel lists a connector's preferred mode first.
+		const drmModeModeInfo *pMode = m_pConnector ? find_mode( m_pConnector.get(), 0, 0, 0 ) : nullptr;
+		return pMode ? pMode->vrefresh : 0;
+	}
+
 	int CDRMConnector::Present( const FrameInfo_t *pFrameInfo, bool bAsync )
 	{
 		return HackyDRMPresent( pFrameInfo, bAsync );
--- a/src/steamcompmgr.cpp
+++ b/src/steamcompmgr.cpp
@@ -1265,6 +1265,7 @@ bool g_nCombinedAppRefreshCycleChangeRef
 bool g_nCombinedAppRefreshCycleChangeFPS[gamescope::GAMESCOPE_SCREEN_TYPE_COUNT] = { true, true };
 
 gamescope::ConVar<bool> cv_refresh_prefer_lowest( "refresh_prefer_lowest", true, "For a frame limit, run the panel at the lowest valid rate the limit divides into instead of the highest." );
+gamescope::ConVar<bool> cv_refresh_ui_preferred( "refresh_ui_preferred", true, "With no game focused, run the panel at its preferred mode's rate instead of the highest." );
 
 static void _update_app_target_refresh_cycle()
 {
@@ -3509,10 +3510,17 @@ paint_all( global_focus_t *pFocus, bool
 
 		int nDynamicRefreshHz = g_nDynamicRefreshRate[GetBackend()->GetScreenType()];
 
-		int nTargetRefreshHz = nDynamicRefreshHz && steamcompmgr_window_should_refresh_switch( pFocus->focusWindow )
+		bool bFollowApp = steamcompmgr_window_should_refresh_switch( pFocus->focusWindow );
+		int nTargetRefreshHz = nDynamicRefreshHz && bFollowApp
 			? nDynamicRefreshHz
 			: int( rates[ rates.size() - 1 ] );
 
+		// Steam's own UI, with no game to follow: the panel's preferred rate.
+		uint32_t uPreferredHz = pConnector->GetPreferredRefreshRate();
+		if ( cv_refresh_ui_preferred && !bFollowApp && !pConnector->IsVRRActive() &&
+			 std::find( rates.begin(), rates.end(), uPreferredHz ) != rates.end() )
+			nTargetRefreshHz = int( uPreferredHz );
+
 		uint64_t now = get_time_in_nanos();
 
 		// The actual output hz generated by the mode, could be off by one either side, due to rounding.
