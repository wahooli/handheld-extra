# gamescope for ARM handhelds: the OpenGamingCollective fork plus armada's 13
# handheld patches -- EDID synthesis for edidless internal panels, gamma22 HDR
# composition without hardware colour management, arm64 Steam night mode,
# drm-lease. Those patches are the reason this package exists.
#
# The BASE is not tracked: the PKGBUILD builds the fork's `ogc` branch, which is
# what the patches are maintained against. Pinning a commit would drift away from
# them rather than with them; if the fork moves ahead, prepare() fails loudly.
# TRACK=oci: the published ARTIFACT is the signal, not the publisher's git
# history. armada can ship a rebuild with no change under gamescope/ -- a
# dependency bump, or a TERRA_COMMIT move which lives at their repo root -- and
# watching that directory would report "up to date" against a package that has
# been rebuilt.
#
# Resolved from the registry by digest: whichever release tag `latest` points at.
# No GitHub API, so no rate limit.
TRACK=oci
OCI_IMAGE=ghcr.io/armada-os/armada-packages/gamescope
OCI_TAG_RE=^[0-9]{8}-[0-9a-f]{8}$

# The patch set that went into that artifact. The tag is <date>-<short-sha> and
# the sha half is the commit it was built from, so PATCHES_REF strips the date
# to get a git ref and the patches match the published build exactly.
PATCHES_REPO=armada-os/armada-packages
PATCHES_PATH=gamescope
PATCHES_REF=s/^[0-9]+-//

CURRENT=20260917-c8c19ee8

# pkgver is the published tag with the dash swapped for a dot (pkgver forbids
# dashes), so `pacman -Q gamescope` names exactly which armada build is installed.
VERSION_FROM=oci-tag

# ── the source ref, derived from the SAME artifact as the patches ───────────
#
# armada packages from Terra rather than from a tree of their own: they clone
# terrapkg at a pinned TERRA_COMMIT and inject the patches above into Terra's
# spec, and it is that spec which names the upstream ref. So the ref their
# patches are written against is two hops from the published artifact:
#
#   CURRENT -> armada commit -> TERRA.env TERRA_COMMIT -> terra spec -> ref
#
# Resolving it here means the source and the patch set are always read from ONE
# artifact and can never come from different moments. The PKGBUILD used to build
# `#branch=ogc` instead -- a moving branch, on the reasoning that armada tracks
# the fork's tip -- and when the branch got far enough ahead of the last
# artifact, 9 of 17 patches stopped applying and every build failed until armada
# published again. Against the ref Terra pinned, that same patch set applies with
# zero fuzz: the branch was the stale half, not the patches.
SOURCE_REF_FROM=armada-terra-spec
SOURCE_REF_VAR=_ogcref
SOURCE_COMMIT_VAR=_ogccommit
SOURCE_GIT=https://github.com/OpenGamingCollective/gamescope.git

TERRA_ENV_FILE=TERRA.env
TERRA_ENV_KEY=TERRA_COMMIT
TERRA_SPEC_REPO=terrapkg/packages
TERRA_SPEC_PATH=anda/games/terra-gamescope/terra-gamescope.spec
# Tried in order. Terra names the ref as `%global ver <tag>` today and used
# `%global gamescope_commit <sha>` before it; older artifacts still resolve
# through the second spelling, so both stay listed.
TERRA_SPEC_KEYS="ver gamescope_commit"
