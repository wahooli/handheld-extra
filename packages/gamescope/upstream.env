# gamescope for ARM handhelds: the OpenGamingCollective fork plus armada's 13
# handheld patches -- EDID synthesis for edidless internal panels, gamma22 HDR
# composition without hardware colour management, arm64 Steam night mode,
# drm-lease. Those patches are the reason this package exists.
#
# The BASE is not tracked: the PKGBUILD builds the fork's `ogc` branch, which is
# what the patches are maintained against. Pinning a commit would drift away from
# them rather than with them; if the fork moves ahead, prepare() fails loudly.
# TRACK=oci: the published ARTIFACT is the signal, not the publisher's git
# history. armada can ship a rebuild with no change under gamescope/ -- a
# dependency bump, or a TERRA_COMMIT move which lives at their repo root -- and
# watching that directory would report "up to date" against a package that has
# been rebuilt.
#
# Resolved from the registry by digest: whichever release tag `latest` points at.
# No GitHub API, so no rate limit.
TRACK=oci
OCI_IMAGE=ghcr.io/armada-os/armada-packages/gamescope
OCI_TAG_RE=^[0-9]{8}-[0-9a-f]{8}$

# The patch set that went into that artifact. The tag is <date>-<short-sha> and
# the sha half is the commit it was built from, so PATCHES_REF strips the date
# to get a git ref and the patches match the published build exactly.
PATCHES_REPO=armada-os/armada-packages
PATCHES_PATH=gamescope
PATCHES_REF=s/^[0-9]+-//

CURRENT=20260830-2c93e73c

# pkgver is the published tag with the dash swapped for a dot (pkgver forbids
# dashes), so `pacman -Q gamescope` names exactly which armada build is installed.
VERSION_FROM=oci-tag
