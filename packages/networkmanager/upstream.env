# NetworkManager with armada's keep-devices-active-on-suspend patch.
#
# TWO independent axes, and neither one alone is enough:
#
#   the PATCH SET   armada's, tracked below with TRACK=github-paths
#   the SOURCE      NetworkManager itself, which comes from ALARM/Arch and NOT
#                   from armada -- their build is a Fedora SRPM (BASE.env says
#                   NetworkManager-1.56.1-2.fc44), ours is Arch's 1.58.1
#                   packaging. The patch applies cleanly to both; the version
#                   numbers have nothing to do with each other.
#
# That split is why VERSION_FROM is absent and AUTOBUMP is no. Every
# VERSION_FROM bump-package.sh knows how to do would write armada's Fedora
# version, or their commit, into a pkgver that has to track Arch's.

# ── axis 1: the patch set ─────────────────────────────────────────────────────
#
# armada-os/armada-packages was ARCHIVED on 2026-09-18 and its contents moved
# into armada-os/armada under packages/. The OCI artifacts went with it: the new
# repo tags package images by CONTENT HASH and publishes no `latest`, so there is
# nothing to resolve from and no sha embedded in a tag to read the patch set at.
# The old images still resolve, frozen, and would have gone on reporting "up to
# date" forever.
#
# The commit is the release now. The old comment here argued for the artifact
# over the git history, because armada could rebuild with nothing changed under
# networkmanager/ and a directory watch would call that "up to date". That
# concern inverts once the artifact is gone: we never consumed their image, and
# this package consumes exactly one thing from them -- the patch below. A rebuild
# that does not touch it is genuinely nothing to do, which is precisely what
# their last two artifact tags were: 78f00c74 and 9a00ae38 carry a byte-identical
# patch and BASE.env, so the bump that was pending when the repo was archived
# would have rebuilt this package for no reason.
TRACK=github-paths
GITHUB_REPO=armada-os/armada
TRACK_PATHS="packages/networkmanager/patches packages/networkmanager/BASE.env"

# The patch set, read at the tracked commit. PATCHES_REF is unset: CURRENT is
# already the git ref, which is the default.
PATCHES_REPO=armada-os/armada
PATCHES_PATH=packages/networkmanager

CURRENT=956bd2c73e612e9a42ceedc558caafa79fb5456a

# NOT auto-bumped, for the reason at the top: there is no version here to derive
# from this commit. A move means "armada changed their patches" and the work is
#   scripts/fetch-patch-set.sh networkmanager
#   read the diff, confirm it still applies to whatever pkgver says
#   bump pkgrel by hand
# which is a review, not an increment.
AUTOBUMP=no

# ── axis 2: the source, and the one that can lose the patch silently ─────────
# This is a SHADOWING package: it builds the same four pkgnames ALARM already
# publishes (networkmanager, libnm, nm-cloud-setup, networkmanager-docs) and
# wins only by carrying a higher pkgrel at the same pkgver. The moment ALARM
# ships 1.59.0-1, THEIR package is newer than our 1.58.1-2, pacman takes it, and
# the suspend patch is gone from the device. Nothing fails, nothing logs -- Wi-Fi
# just starts dropping on suspend again.
#
# ABI_PIN_* is the existing mechanism for "this package is pinned to a version
# ALARM controls", and it is reused here for exactly that reading of the ALARM
# sync db. Read the generated report with one substitution: for hyprgrass the
# consequence is `pacman -Syu` refusing the transaction, for this package the
# consequence is the silent loss above. The trigger is the same event and the
# fix is the same shape -- follow ALARM's version, refresh, republish.
#
# What this does NOT catch: ALARM rebuilding 1.58.1 itself to -2 or higher, since
# the comparison strips pkgrel. That collides with ours at equal version, where
# pacman falls back to repo order and the outcome depends on each device's
# pacman.conf. If it happens, raise our pkgrel above theirs.
ABI_PIN_PKG=networkmanager
ABI_PIN_REPO=extra
ABI_PIN_VAR=pkgver
