TRACK=github-release
GITHUB_REPO=OpenHandheldCollective/OpenABL
CURRENT=v1.1
VERSION_FROM=upstream-tag

# Reported, never bumped by CI: a published package is flashed onto every
# device's abl_a/abl_b by its pacman hook. Read the release notes first (v1.0
# hung at random starting a boot image; an open PR would start EFI-stub kernels
# through the stub), then `scripts/bump-package.sh openabl-sm8750`.
AUTOBUMP=no
