TRACK=github-release
GITHUB_REPO=OpenHandheldCollective/OpenABL
CURRENT=v1.2
VERSION_FROM=upstream-tag

# Bumped by CI like the rest. Each published version is flashed onto every
# device's abl_a/abl_b by its pacman hook (openabl-update), so a bad release
# reaches every device on its next update: watch the first boot after one.
# openabl-update refuses an image whose SoC or release it does not know.
AUTOBUMP=yes
