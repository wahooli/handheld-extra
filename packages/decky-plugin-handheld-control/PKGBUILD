# Handheld Control — our own Decky plugin, for the one gap the native Deck UI
# leaves.
#
# The Deck UI already renders power profile and GPU clock, driven over
# com.steampowered.SteamOSManager1 (see overlay/usr/libexec/handheld/). What it
# has no concept of at all is a FAN CURVE, and that is the control this plugin
# exists to add — plus a live temperature/PWM/RPM readout, which is what makes a
# fan curve verifiable on real hardware rather than a guess.
#
# ── why not port armada-control ────────────────────────────────────────────────
# Armada ships a far bigger plugin, and almost none of it would work here:
#
#   src/tabs/Compatibility.tsx   843 lines  needs host FEX + their tweaks daemon
#   src/tabs/Settings.tsx        136 lines  needs inputplumber for controller
#                                           emulation and stick calibration
#   src/tabs/Power.tsx            79 lines  the only part that maps onto our stack
#
# and its backend reaches privilege through a bespoke JSON-over-unix-socket API
# at /run/armada/control.sock served by /usr/libexec/armada/armada-control — a
# daemon we do not have and would have to reimplement. So porting means adopting
# their whole runtime (inputplumber, host FEX, the control socket) or keeping 79
# of 2506 lines and rewiring even those. This file is the smaller honest option.
#
# Unlike every other package here, the source is IN THIS REPO rather than fetched
# — same as the patched packages here carry their own patches/.

pkgname=decky-plugin-handheld-control
pkgver=1.0.0
pkgrel=1
pkgdesc='Decky plugin: fan curve, power profile and live thermals via org.handheld.Power1'
arch=('aarch64')
url='https://github.com/SteamDeckHomebrew/decky-loader'
license=('GPL-2.0-or-later')
# Nothing at runtime from pacman's point of view, but note the REAL runtime
# dependency: main.py shells out to /usr/bin/handheld-power, which the overlay
# installs (not a package), so pacman cannot express it. If that binary is
# missing the panel renders an error rather than failing silently.
depends=()
makedepends=('nodejs' 'npm' 'pnpm')
# No source=(): the plugin lives in this directory. makepkg copies the whole
# directory into a scratch tree before building, so $startdir is safe to read and
# nothing is written back into the repo.
source=()
sha256sums=()

build() {
    cd "${startdir}"

    # Keep every cache inside the build area — makepkg runs this as the
    # unprivileged `build` user and pnpm must not write to its home.
    export HOME="${srcdir}/.home"
    export XDG_CACHE_HOME="${srcdir}/.cache"
    export npm_config_cache="${srcdir}/.npm"
    export PNPM_HOME="${srcdir}/.pnpm"
    mkdir -p "${HOME}" "${XDG_CACHE_HOME}" "${PNPM_HOME}"

    # NOTE on package.json: the upstream decky-plugin-template pins
    # `@rollup/rollup-linux-x64-musl` in devDependencies. That is an x86_64
    # native binary and pinning it here would either fail to install or install
    # something unusable. Ours omits it deliberately and lets rollup resolve its
    # own platform binary through optionalDependencies — which on this builder
    # means @rollup/rollup-linux-arm64-gnu.
    #
    # No --frozen-lockfile because there is no lockfile committed: this is a
    # four-dependency plugin and a lockfile that only ever gets regenerated by
    # this build would be noise. The tradeoff is that a breaking @decky/ui
    # release shows up as a build failure here, which is the right place for it.
    pnpm install --dangerously-allow-all-builds
    pnpm run build

    [ -f dist/index.js ] \
        || { echo "PKGBUILD: rollup produced no dist/index.js" >&2; return 1; }
}

package() {
    cd "${startdir}"

    # Directory name must match plugin.json's `name` — Decky keys a backend to
    # its frontend bundle by it. "Handheld Control" has a space, which is legal
    # and is what upstream plugins do (see "Example Plugin" in the template).
    local dest="${pkgdir}/usr/share/decky-plugins/Handheld Control"
    install -d "${dest}"

    install -Dm0644 plugin.json package.json main.py -t "${dest}/"
    cp -a dist "${dest}/dist"
    rm -f "${dest}/dist/"*.map

    # The loader expects this to exist for any plugin with a backend, even when
    # there are no extra modules to put in it.
    install -d "${dest}/py_modules"
}
