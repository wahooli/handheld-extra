# Xenia has no releases, only rolling canary builds, and none of them for Linux
# on arm64. canary_experimental is the branch with the A64 CPU backend
# (src/xenia/cpu/backend/a64), so this follows its head the way lsfg-vk-git
# follows master: `<commit date>.<sha8>`.
#
# The branch moves most days and every build is ~700 compile steps plus a
# ThinLTO link, so the poller only looks once a week.
TRACK=git-branch
GIT_URL=https://github.com/xenia-canary/xenia-canary.git
GIT_BRANCH=canary_experimental
CURRENT=44e6489cf87567b5dc9c982207765d722b71b966
VERSION_FROM=commit-date
POLL_DAYS="Sat"
