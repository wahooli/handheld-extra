+void GPU_fdinfo::find_msm_devfreq()
+{
+    const std::string devfreq_root = "/sys/class/devfreq";
+
+    if (!fs::exists(devfreq_root)) {
+        SPDLOG_DEBUG("msm: \"{}\" does not exist", devfreq_root);
+        return;
+    }
+
+    // Adreno's devfreq node is named for the GPU's platform address, e.g.
+    // "3d00000.gpu" on X1E. There is no busy-percent file here, only the
+    // frequency -- load still comes from fdinfo.
+    for (const auto& entry : fs::directory_iterator(devfreq_root)) {
+        auto name = entry.path().filename().string();
+
+        if (name.size() < 4 || name.compare(name.size() - 4, 4, ".gpu") != 0)
+            continue;
+
+        auto cur_freq = entry.path().string() + "/cur_freq";
+
+        if (!fs::exists(cur_freq))
+            continue;
+
+        gpu_clock_stream.open(cur_freq);
+
+        if (!gpu_clock_stream.good()) {
+            SPDLOG_DEBUG("msm: failed to open \"{}\"", cur_freq);
+            return;
+        }
+
+        SPDLOG_DEBUG("msm: gpu clock found at \"{}\"", cur_freq);
+        return;
+    }
+
+    SPDLOG_DEBUG("msm: no gpu devfreq node found under \"{}\"", devfreq_root);
+}
