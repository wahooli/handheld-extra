 #include "battery.h"
 
 namespace fs = ghc::filesystem;
 using namespace std;
 
+static std::string read_psy_attr(const fs::path& dir, const char* attr)
+{
+    std::ifstream stream(dir / attr);
+    std::string value;
+
+    std::getline(stream, value);
+
+    return value;
+}
+
+// A power_supply attribute can exist as a file and still fail every read: the
+// driver publishes the property but returns an error for it. qcom_battmgr does
+// exactly that with charge_now/charge_full on batteries that report energy, so
+// fs::exists() is not a usable test for "this reading is available" -- the
+// value has to actually come back and parse.
+static bool read_psy_value(const std::string& path, float& out)
+{
+    std::ifstream stream(path);
+    std::string line;
+
+    if (!std::getline(stream, line) || line.empty())
+        return false;
+
+    try {
+        out = std::stof(line);
+    } catch (const std::exception&) {
+        return false;
+    }
+
+    return true;
+}
