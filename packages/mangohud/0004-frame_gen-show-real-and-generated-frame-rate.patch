diff --git a/src/framegen.cpp b/src/framegen.cpp
new file mode 100644
index 0000000..e5f1f05
--- /dev/null
+++ b/src/framegen.cpp
@@ -0,0 +1,97 @@
+#include "framegen.h"
+
+#include <cstring>
+#include <string>
+#include <dlfcn.h>
+#include <link.h>
+#include <spdlog/spdlog.h>
+
+namespace framegen {
+
+stats current;
+
+namespace {
+
+struct probe_stats {
+    uint32_t version;
+    uint32_t reserved;
+    uint64_t presents;
+    uint64_t last_present_ns;
+};
+
+const probe_stats *g_probe {nullptr};
+bool g_lsfg_loaded {false};
+uint64_t g_last_presents {0};
+int g_lookups {0};
+
+struct scan {
+    std::string probe_path;
+    bool lsfg {false};
+};
+
+int on_object(struct dl_phdr_info *info, size_t, void *data)
+{
+    auto *s = static_cast<scan *>(data);
+    if (!info->dlpi_name || !*info->dlpi_name)
+        return 0;
+    const char *base = std::strrchr(info->dlpi_name, '/');
+    base = base ? base + 1 : info->dlpi_name;
+    if (!std::strcmp(base, "libMangoHud_probe.so"))
+        s->probe_path = info->dlpi_name;
+    else if (!std::strncmp(base, "liblsfg-vk-layer", sizeof("liblsfg-vk-layer") - 1))
+        s->lsfg = true;
+    return 0;
+}
+
+bool locate()
+{
+    scan s;
+    dl_iterate_phdr(on_object, &s);
+    g_lsfg_loaded = s.lsfg;
+    current.label = g_lsfg_loaded ? "LSFG" : "FRAMEGEN";
+
+    if (s.probe_path.empty())
+        return false;
+    void *h = dlopen(s.probe_path.c_str(), RTLD_NOW | RTLD_NOLOAD);
+    if (!h)
+        return false;
+    auto *p = static_cast<const probe_stats *>(dlsym(h, "mangohud_probe_stats"));
+    if (!p || p->version != 1) {
+        SPDLOG_DEBUG("frame generation probe found but unusable (version {})", p ? p->version : 0);
+        return false;
+    }
+    g_probe = p;
+    g_last_presents = __atomic_load_n(&p->presents, __ATOMIC_RELAXED);
+    SPDLOG_DEBUG("frame generation probe attached: {}", s.probe_path);
+    return true;
+}
+
+}
+
+void update(double own_fps, uint64_t elapsed_ns)
+{
+    if (!g_probe) {
+        if (g_lookups++ % 4 == 0)
+            current.probe_found = locate();
+        if (!g_probe) {
+            current.active = false;
+            return;
+        }
+    }
+
+    const uint64_t presents = __atomic_load_n(&g_probe->presents, __ATOMIC_RELAXED);
+    const uint64_t delta = presents - g_last_presents;
+    g_last_presents = presents;
+    if (elapsed_ns == 0)
+        return;
+    const double probe_fps = 1e9 * double(delta) / double(elapsed_ns);
+
+    current.probe_found = true;
+    current.overlay_is_input = probe_fps >= own_fps;
+    current.input_fps  = current.overlay_is_input ? own_fps : probe_fps;
+    current.output_fps = current.overlay_is_input ? probe_fps : own_fps;
+    current.ratio = current.input_fps > 0 ? current.output_fps / current.input_fps : 1.0;
+    current.active = current.input_fps > 0 && current.ratio >= 1.15;
+}
+
+}
