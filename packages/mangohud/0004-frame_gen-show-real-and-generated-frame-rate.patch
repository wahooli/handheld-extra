new file mode 100644
index 0000000..97dd621
--- /dev/null
+++ b/src/framegen.h
@@ -0,0 +1,25 @@
+#pragma once
+#ifndef MANGOHUD_FRAMEGEN_H
+#define MANGOHUD_FRAMEGEN_H
+
+#include <cstdint>
+
+namespace framegen {
+
+struct stats {
+    bool probe_found {false};
+    bool active {false};
+    bool overlay_is_input {true};
+    double input_fps {0};
+    double output_fps {0};
+    double ratio {1};
+    const char *label {"FRAMEGEN"};
+};
+
+extern stats current;
+
+void update(double own_fps, uint64_t elapsed_ns);
+
+}
+
+#endif
diff --git a/src/framegen_probe.c b/src/framegen_probe.c
new file mode 100644
index 0000000..2a27863
--- /dev/null
+++ b/src/framegen_probe.c
@@ -0,0 +1,259 @@
+#define _POSIX_C_SOURCE 200809L
+
+#include <pthread.h>
+#include <stdint.h>
+#include <stdlib.h>
+#include <string.h>
+#include <time.h>
+
+#include <vulkan/vulkan.h>
+#include <vulkan/vk_layer.h>
+
+#define PROBE_EXPORT __attribute__((visibility("default")))
+
+struct mangohud_probe_stats {
+    uint32_t version;
+    uint32_t reserved;
+    uint64_t presents;
+    uint64_t last_present_ns;
+};
+
+PROBE_EXPORT struct mangohud_probe_stats mangohud_probe_stats = { 1, 0, 0, 0 };
+
+#define DISPATCH_KEY(obj) (*(void **)(obj))
+
+struct instance_entry {
+    void *key;
+    VkInstance instance;
+    PFN_vkGetInstanceProcAddr gipa;
+    struct instance_entry *next;
+};
+
+struct device_entry {
+    void *key;
+    PFN_vkGetDeviceProcAddr gdpa;
+    PFN_vkQueuePresentKHR queue_present;
+    PFN_vkDestroyDevice destroy_device;
+    struct device_entry *next;
+};
+
+static pthread_mutex_t g_lock = PTHREAD_MUTEX_INITIALIZER;
+static struct instance_entry *g_instances;
+static struct device_entry *g_devices;
+
+static struct instance_entry *find_instance(void *key)
+{
+    struct instance_entry *e;
+    pthread_mutex_lock(&g_lock);
+    for (e = g_instances; e && e->key != key; e = e->next)
+        ;
+    pthread_mutex_unlock(&g_lock);
+    return e;
+}
+
+static struct device_entry *find_device(void *key)
+{
+    struct device_entry *e;
+    pthread_mutex_lock(&g_lock);
+    for (e = g_devices; e && e->key != key; e = e->next)
+        ;
+    pthread_mutex_unlock(&g_lock);
+    return e;
+}
+
+static void remove_instance(void *key)
+{
+    struct instance_entry **p;
+    pthread_mutex_lock(&g_lock);
+    for (p = &g_instances; *p; p = &(*p)->next) {
+        if ((*p)->key == key) {
+            struct instance_entry *dead = *p;
+            *p = dead->next;
+            free(dead);
+            break;
+        }
+    }
+    pthread_mutex_unlock(&g_lock);
+}
+
+static void remove_device(void *key)
+{
+    struct device_entry **p;
+    pthread_mutex_lock(&g_lock);
+    for (p = &g_devices; *p; p = &(*p)->next) {
+        if ((*p)->key == key) {
+            struct device_entry *dead = *p;
+            *p = dead->next;
+            free(dead);
+            break;
+        }
+    }
+    pthread_mutex_unlock(&g_lock);
+}
+
+static uint64_t now_ns(void)
+{
+    struct timespec ts;
+    clock_gettime(CLOCK_MONOTONIC, &ts);
+    return (uint64_t)ts.tv_sec * 1000000000ull + (uint64_t)ts.tv_nsec;
+}
+
+static VKAPI_ATTR PFN_vkVoidFunction VKAPI_CALL probe_GetInstanceProcAddr(VkInstance instance, const char *name);
+static VKAPI_ATTR PFN_vkVoidFunction VKAPI_CALL probe_GetDeviceProcAddr(VkDevice device, const char *name);
+
+static VKAPI_ATTR VkResult VKAPI_CALL probe_CreateInstance(
+    const VkInstanceCreateInfo *pCreateInfo,
+    const VkAllocationCallbacks *pAllocator,
+    VkInstance *pInstance)
+{
+    VkLayerInstanceCreateInfo *chain = (VkLayerInstanceCreateInfo *)pCreateInfo->pNext;
+    while (chain && !(chain->sType == VK_STRUCTURE_TYPE_LOADER_INSTANCE_CREATE_INFO &&
+                      chain->function == VK_LAYER_LINK_INFO))
+        chain = (VkLayerInstanceCreateInfo *)chain->pNext;
+    if (!chain)
+        return VK_ERROR_INITIALIZATION_FAILED;
+
+    PFN_vkGetInstanceProcAddr gipa = chain->u.pLayerInfo->pfnNextGetInstanceProcAddr;
+    PFN_vkCreateInstance create = (PFN_vkCreateInstance)gipa(NULL, "vkCreateInstance");
+    if (!create)
+        return VK_ERROR_INITIALIZATION_FAILED;
+
+    chain->u.pLayerInfo = chain->u.pLayerInfo->pNext;
+    VkResult r = create(pCreateInfo, pAllocator, pInstance);
+    if (r != VK_SUCCESS)
+        return r;
+
+    struct instance_entry *e = calloc(1, sizeof(*e));
+    if (!e)
+        return VK_ERROR_OUT_OF_HOST_MEMORY;
+    e->key = DISPATCH_KEY(*pInstance);
+    e->instance = *pInstance;
+    e->gipa = gipa;
+    pthread_mutex_lock(&g_lock);
+    e->next = g_instances;
+    g_instances = e;
+    pthread_mutex_unlock(&g_lock);
+    return VK_SUCCESS;
+}
+
+static VKAPI_ATTR void VKAPI_CALL probe_DestroyInstance(VkInstance instance, const VkAllocationCallbacks *pAllocator)
+{
+    void *key = DISPATCH_KEY(instance);
+    struct instance_entry *e = find_instance(key);
+    if (!e)
+        return;
+    PFN_vkDestroyInstance destroy = (PFN_vkDestroyInstance)e->gipa(instance, "vkDestroyInstance");
+    remove_instance(key);
+    if (destroy)
+        destroy(instance, pAllocator);
+}
+
+static VKAPI_ATTR VkResult VKAPI_CALL probe_CreateDevice(
+    VkPhysicalDevice physicalDevice,
+    const VkDeviceCreateInfo *pCreateInfo,
+    const VkAllocationCallbacks *pAllocator,
+    VkDevice *pDevice)
+{
+    struct instance_entry *ie = find_instance(DISPATCH_KEY(physicalDevice));
+    if (!ie)
+        return VK_ERROR_INITIALIZATION_FAILED;
+
+    VkLayerDeviceCreateInfo *chain = (VkLayerDeviceCreateInfo *)pCreateInfo->pNext;
+    while (chain && !(chain->sType == VK_STRUCTURE_TYPE_LOADER_DEVICE_CREATE_INFO &&
+                      chain->function == VK_LAYER_LINK_INFO))
+        chain = (VkLayerDeviceCreateInfo *)chain->pNext;
+    if (!chain)
+        return VK_ERROR_INITIALIZATION_FAILED;
+
+    PFN_vkGetInstanceProcAddr gipa = chain->u.pLayerInfo->pfnNextGetInstanceProcAddr;
+    PFN_vkGetDeviceProcAddr gdpa = chain->u.pLayerInfo->pfnNextGetDeviceProcAddr;
+    PFN_vkCreateDevice create = (PFN_vkCreateDevice)gipa(ie->instance, "vkCreateDevice");
+    if (!create)
+        return VK_ERROR_INITIALIZATION_FAILED;
+
+    chain->u.pLayerInfo = chain->u.pLayerInfo->pNext;
+    VkResult r = create(physicalDevice, pCreateInfo, pAllocator, pDevice);
+    if (r != VK_SUCCESS)
+        return r;
+
+    struct device_entry *e = calloc(1, sizeof(*e));
+    if (!e)
+        return VK_ERROR_OUT_OF_HOST_MEMORY;
+    e->key = DISPATCH_KEY(*pDevice);
+    e->gdpa = gdpa;
+    e->queue_present = (PFN_vkQueuePresentKHR)gdpa(*pDevice, "vkQueuePresentKHR");
+    e->destroy_device = (PFN_vkDestroyDevice)gdpa(*pDevice, "vkDestroyDevice");
+    pthread_mutex_lock(&g_lock);
+    e->next = g_devices;
+    g_devices = e;
+    pthread_mutex_unlock(&g_lock);
+    return VK_SUCCESS;
+}
+
+static VKAPI_ATTR void VKAPI_CALL probe_DestroyDevice(VkDevice device, const VkAllocationCallbacks *pAllocator)
+{
+    void *key = DISPATCH_KEY(device);
+    struct device_entry *e = find_device(key);
+    if (!e)
+        return;
+    PFN_vkDestroyDevice destroy = e->destroy_device;
+    remove_device(key);
+    if (destroy)
+        destroy(device, pAllocator);
+}
+
+static VKAPI_ATTR VkResult VKAPI_CALL probe_QueuePresentKHR(VkQueue queue, const VkPresentInfoKHR *pPresentInfo)
+{
+    struct device_entry *e = find_device(DISPATCH_KEY(queue));
+    if (!e || !e->queue_present)
+        return VK_ERROR_DEVICE_LOST;
+
+    __atomic_store_n(&mangohud_probe_stats.last_present_ns, now_ns(), __ATOMIC_RELAXED);
+    __atomic_fetch_add(&mangohud_probe_stats.presents, 1, __ATOMIC_RELAXED);
+    return e->queue_present(queue, pPresentInfo);
+}
+
+static PFN_vkVoidFunction probe_intercept(const char *name)
+{
+    if (!strcmp(name, "vkGetInstanceProcAddr")) return (PFN_vkVoidFunction)probe_GetInstanceProcAddr;
+    if (!strcmp(name, "vkGetDeviceProcAddr"))   return (PFN_vkVoidFunction)probe_GetDeviceProcAddr;
+    if (!strcmp(name, "vkCreateInstance"))      return (PFN_vkVoidFunction)probe_CreateInstance;
+    if (!strcmp(name, "vkDestroyInstance"))     return (PFN_vkVoidFunction)probe_DestroyInstance;
+    if (!strcmp(name, "vkCreateDevice"))        return (PFN_vkVoidFunction)probe_CreateDevice;
+    if (!strcmp(name, "vkDestroyDevice"))       return (PFN_vkVoidFunction)probe_DestroyDevice;
+    if (!strcmp(name, "vkQueuePresentKHR"))     return (PFN_vkVoidFunction)probe_QueuePresentKHR;
+    return NULL;
+}
+
+static VKAPI_ATTR PFN_vkVoidFunction VKAPI_CALL probe_GetDeviceProcAddr(VkDevice device, const char *name)
+{
+    PFN_vkVoidFunction f = probe_intercept(name);
+    if (f)
+        return f;
+    struct device_entry *e = find_device(DISPATCH_KEY(device));
+    return e ? e->gdpa(device, name) : NULL;
+}
+
+static VKAPI_ATTR PFN_vkVoidFunction VKAPI_CALL probe_GetInstanceProcAddr(VkInstance instance, const char *name)
+{
+    PFN_vkVoidFunction f = probe_intercept(name);
+    if (f)
+        return f;
+    if (!instance)
+        return NULL;
+    struct instance_entry *e = find_instance(DISPATCH_KEY(instance));
+    return e ? e->gipa(instance, name) : NULL;
+}
+
+PROBE_EXPORT VKAPI_ATTR VkResult VKAPI_CALL vkNegotiateLoaderLayerInterfaceVersion(VkNegotiateLayerInterface *pVersionStruct)
+{
+    if (!pVersionStruct || pVersionStruct->sType != LAYER_NEGOTIATE_INTERFACE_STRUCT)
+        return VK_ERROR_INITIALIZATION_FAILED;
+    if (pVersionStruct->loaderLayerInterfaceVersion < 2)
+        return VK_ERROR_INITIALIZATION_FAILED;
+    pVersionStruct->loaderLayerInterfaceVersion = 2;
+    pVersionStruct->pfnGetInstanceProcAddr = probe_GetInstanceProcAddr;
+    pVersionStruct->pfnGetDeviceProcAddr = probe_GetDeviceProcAddr;
+    pVersionStruct->pfnGetPhysicalDeviceProcAddr = NULL;
+    return VK_SUCCESS;
+}
