 src/hud_elements.h                  |   1 +
 src/mangohud_framegen_order.json.in |  18 ++
 src/mangohud_probe.json.in          |  20 +++
 src/meson.build                     |  28 +++
 src/overlay.cpp                     |   2 +
 src/overlay_params.cpp              |   4 +
 src/overlay_params.h                |   1 +
 12 files changed, 488 insertions(+)
