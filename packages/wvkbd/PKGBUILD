pkgname=wvkbd
pkgver=0.20
pkgrel=3
pkgdesc='On-screen keyboard for wlroots (Finnish å/ä/ö in the latin layouts)'
url='https://git.sr.ht/~proycon/wvkbd'
arch=('aarch64')
license=('GPL3')
depends=('wayland' 'pango' 'cairo' 'glibc')
makedepends=('fontconfig' 'libxkbcommon' 'scdoc')
source=("$pkgname-$pkgver.tar.gz::https://git.sr.ht/~proycon/wvkbd/archive/v$pkgver.tar.gz")
sha512sums=('1c5204dc00f7a3bdfd199dfa88b513c46249b7832ba546c0554940539fcc4e0d55303a9f6edd17dd82fd2893b602b86395202311b3ec851f5e8f41895f682371')

_patches=(
  0001-layout-add-Finnish-a-o-a-to-the-latin-layouts.patch
)

prepare() {
  cd "$pkgname-v$pkgver"

  local p f
  for p in "${_patches[@]}"; do
    f="${startdir}/patches/${p}"
    [ -f "${f}" ] || { echo "::  missing patch: ${p}"; return 1; }

    if ! patch -p1 --batch --forward -F0 --dry-run --quiet < "${f}"; then
      echo "::  FAILED: ${p}"
      echo "::  wvkbd moved under the patch — rebase it against ${pkgver}."
      return 1
    fi
    patch -p1 --batch --forward -F0 --quiet < "${f}"
    echo "::  applied: ${p}"
  done
}

build() {
  make -C "$pkgname-v$pkgver"
}

check() {
  local f="$pkgname-v$pkgver/layout.mobintl.h"
  local spec n
  for spec in 'å:0x00E5, 0, 0x00C5' 'ä:0x00E4, 0, 0x00C4' 'ö:0x00F6, 0, 0x00D6'; do
    n=$(grep -c -- "${spec#*:}" "$f")
    [ "$n" -eq 4 ] || {
      echo "::  ${spec%%:*}: expected 4 occurrences of '${spec#*:}', found ${n}"
      echo "::  a patch hunk did not land — rebase patches/ against ${pkgver}."
      return 1
    }
  done
}

package() {
  make -C "$pkgname-v$pkgver" PREFIX=/usr DESTDIR="$pkgdir" install
}
