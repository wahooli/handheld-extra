# Prereleases count here: 3.2.8rc1 is what is currently packaged, so restricting
# to stable releases would report it as ahead of upstream forever.
TRACK=github-release
GITHUB_REPO=SteamDeckHomebrew/decky-loader
INCLUDE_PRERELEASE=1
# The RAW upstream tag, not the packaged form. CURRENT is compared against what
# upstream publishes, so it has to be in upstream's spelling; VERSION_SED turns
# it into the pkgver. Storing '3.2.8rc1' here made the poller compare a
# transformed value against an untransformed one and report a bump every run
# for a package that was already current.
CURRENT=v3.2.8
# Upstream tags look like v3.2.8-pre1 but pkgver forbids dashes, and this package
# has always spelled it 3.2.8rc1. VERSION_SED maps one to the other; without it
# an auto-bump would write an invalid pkgver and makepkg would refuse the build.
VERSION_FROM=upstream-tag
# Quoted, and that is load-bearing: upstream.env is SOURCED, so an unquoted
# value containing semicolons runs everything after the first one as a shell
# command.
VERSION_SED='s/^v//; s/-pre/rc/; s/-rc/rc/; s/-//g'
