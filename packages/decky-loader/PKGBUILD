pkgname=decky-loader
pkgver=3.2.10rc1
_tag=v3.2.8-pre1
pkgrel=1
pkgdesc='Plugin loader for the Steam Deck UI (native aarch64 build)'
arch=(aarch64)
url=https://github.com/SteamDeckHomebrew/decky-loader
license=(GPL-2.0-only)
depends=(glibc)
makedepends=(git nodejs npm pnpm python python-pip)
source=("git+${url}.git#tag=${_tag}")
sha256sums=('SKIP')

_srcdir="${pkgname}"

prepare() {
  cd "${srcdir}/${_srcdir}"

  sed -i 's/^python = ">=3.10,<3.14"/python = ">=3.10,<3.16"/' backend/pyproject.toml
  grep -q '^python = ">=3.10,<3.16"' backend/pyproject.toml \
    || { echo "PKGBUILD: python constraint not patched — upstream changed it" >&2; return 1; }
}

build() {
  cd "${srcdir}/${_srcdir}"

  export HOME="${srcdir}/.home"
  export XDG_CACHE_HOME="${srcdir}/.cache"
  export npm_config_cache="${srcdir}/.npm"
  export PNPM_HOME="${srcdir}/.pnpm"
  export PIP_CACHE_DIR="${srcdir}/.pip"
  mkdir -p "${HOME}" "${XDG_CACHE_HOME}" "${PNPM_HOME}"

  msg2 "frontend (pnpm)"
  pushd frontend > /dev/null
  pnpm i --frozen-lockfile --dangerously-allow-all-builds
  pnpm run build
  popd > /dev/null

  msg2 "backend (pyinstaller)"
  pushd backend > /dev/null
  python3 -m venv "${srcdir}/venv"
  # shellcheck source=/dev/null
  source "${srcdir}/venv/bin/activate"
  python3 -m pip install --upgrade pip

  python3 -m pip install .
  python3 -m pip install pyinstaller

  pyinstaller pyinstaller.spec
  popd > /dev/null

  local _machine
  _machine="$(python3 -c 'print(hex(open("backend/dist/PluginLoader","rb").read(20)[18]))')"
  msg2 "built for ${_machine} (expect 0xb7 = aarch64)"
  [ "${_machine}" = "0xb7" ] \
    || { echo "PKGBUILD: PluginLoader is not aarch64 (${_machine})" >&2; return 1; }
}

package() {
  cd "${srcdir}/${_srcdir}"

  install -Dm0755 backend/dist/PluginLoader "${pkgdir}/usr/share/decky-loader/PluginLoader"

  echo "${_tag}" | install -Dm0644 /dev/stdin "${pkgdir}/usr/share/decky-loader/.loader.version"

  install -Dm0644 LICENSE "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
}
