# Pinned against a Hyprland version as well as its own; a hyprgrass bump that
# targets a newer Hyprland than the image ships is not automatically wanted.
TRACK=github-release
GITHUB_REPO=horriblename/hyprgrass
CURRENT=0.8.2
# NOT auto-bumped, and this governs the RELEASE axis only -- the ABI pin at the
# bottom of this file is auto-bumped and has its own switch. The version lives in
# _srcver, but pkgver is composed with _hyprver -- a hyprgrass release targets a
# specific Hyprland ABI, and taking a new one without checking which Hyprland the
# image ships builds a plugin that loads against the wrong version. That is a
# judgement call, so the poller reports it and stops.
AUTOBUMP=no
VERSION_VAR=_srcver
VERSION_FROM=upstream-tag

# Second axis, independent of the release tracking above. hyprgrass is ABI-pinned
# to ONE exact Hyprland by depends=('hyprland=${_hyprver}'), so ALARM moving
# hyprland makes the published package uninstallable even though hyprgrass itself
# has released nothing. On a device that shows up as `pacman -Syu` refusing the
# whole transaction, which is why arch-arm64 no longer holds hyprland with
# IgnorePkg: this is what is supposed to catch it first.
ABI_PIN_PKG=hyprland
ABI_PIN_REPO=extra
ABI_PIN_VAR=_hyprver

# Auto-bumped, unlike the release axis above -- scripts/bump-abi-pin.sh, run from
# the poller. The two axes get opposite answers on purpose:
#
#   release (AUTOBUMP=no)   taking a NEW hyprgrass is a judgement call about
#                           whether it targets the Hyprland this image ships
#   ABI pin (yes)           following the Hyprland this image ALREADY ships is
#                           not a choice; leaving it is what strands the device
#
# This one was reported-only too, on the grounds that moving _hyprver also means
# finding the hyprgrass commit built against the new Hyprland. That lookup is
# real but it is not judgement: upstream publishes the answer as a table, and
# hyprpm and the AUR package both read the same row this does.
ABI_PIN_AUTOBUMP=yes

# How to resolve that row. ALARM names a pkgver, hyprpm.toml is keyed by Hyprland
# COMMIT, so the release tag bridges the two:
#
#   ALARM extra/hyprland 0.56.2
#     -> hyprwm/Hyprland tag v0.56.2      = efb50993...
#     -> hyprgrass hyprpm.toml commit_pins  = 8e605468...   -> _commit
#
# Exact row or nothing. When ALARM is ahead of upstream's table -- normal for the
# first days after a Hyprland release -- the bump exits 4 and the poller reports
# it for a human instead of taking the neighbouring pin, which is precisely the
# one that will not load.
ABI_PIN_COMMIT_VAR=_commit
ABI_PIN_COMMIT_FROM=hyprpm-toml
ABI_PIN_COMMIT_REPO=horriblename/hyprgrass
ABI_PIN_SRC_GIT=https://github.com/hyprwm/Hyprland.git
ABI_PIN_SRC_TAG_FMT=v%s
