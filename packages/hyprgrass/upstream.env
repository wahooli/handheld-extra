# Pinned against a Hyprland version as well as its own; a hyprgrass bump that
# targets a newer Hyprland than the image ships is not automatically wanted.
TRACK=github-release
GITHUB_REPO=horriblename/hyprgrass
CURRENT=0.8.2
# NOT auto-bumped. The version lives in _srcver, but pkgver is composed with
# _hyprver -- a hyprgrass release targets a specific Hyprland ABI, and taking a
# new one without checking which Hyprland the image ships builds a plugin that
# loads against the wrong version. That is a judgement call, so the poller
# reports it and stops.
AUTOBUMP=no
VERSION_VAR=_srcver
VERSION_FROM=upstream-tag
