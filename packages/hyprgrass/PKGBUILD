pkgname=hyprgrass
_srcver=0.8.2
_hyprver=0.56.2
pkgver="${_srcver}+hypr${_hyprver}"
pkgrel=2
_commit=8e605468cbf429791d61ddbfaeb14ff5e08fec3e
pkgdesc="Touchscreen gesture plugin for Hyprland (built against ${_hyprver})"
arch=('aarch64')
url='https://github.com/horriblename/hyprgrass'
license=('BSD-3-Clause')
depends=("hyprland=${_hyprver}")
makedepends=('git' 'meson' 'ninja' 'cmake' 'pkgconf' 'hyprland' 'glm')
source=("${pkgname}::git+${url}.git#commit=${_commit}")
sha256sums=('SKIP')

prepare() {
    cd "${srcdir}/${pkgname}"

    local have
    have="$(pkg-config --modversion hyprland)"
    if [ "${have}" != "${_hyprver}" ]; then
        echo "::  hyprland headers are ${have}, this package targets ${_hyprver}" >&2
        echo "::  bump _hyprver (and probably _commit) in this PKGBUILD" >&2
        return 1
    fi
    echo "::  building against hyprland ${have}"
}

build() {
    cd "${srcdir}/${pkgname}"

    arch-meson . build \
        -Dtests=disabled \
        -Dwf-touch:tests=disabled \
        -Dhyprgrass=true \
        -Dhyprgrass-pulse=false \
        -Dhyprgrass-backlight=false
    meson compile -C build
}

package() {
    cd "${srcdir}/${pkgname}"

    local so=""
    for candidate in build/src/libhyprgrass.so build/libhyprgrass.so; do
        [ -f "${candidate}" ] && { so="${candidate}"; break; }
    done
    [ -n "${so}" ] || {
        echo "::  no libhyprgrass.so was produced — refusing to ship an empty package" >&2
        find build -name '*.so' -printf '::  found instead: %p\n' >&2
        return 1
    }

    install -Dm0755 "${so}" "${pkgdir}/usr/lib/libhyprgrass.so"
    install -Dm0644 LICENSE "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
}
