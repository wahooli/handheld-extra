# mesa main, for turnip fixes that have not reached a release yet. Games opt in
# one at a time with `turnip-devel %command%`; vulkan-freedreno stays the driver
# everything else uses.
#
# main moves several times a day and every publish is a download for every
# device that has the package, in a repo the kernels share, so the poller only
# looks on POLL_DAYS (UTC weekdays). A devel driver needs to be recent, not
# current.
TRACK=git-branch
GIT_URL=https://gitlab.freedesktop.org/mesa/mesa.git
GIT_BRANCH=main
CURRENT=8e557130bda2adcb87535aabe23bca0d68ff77b6
VERSION_FROM=commit-date
POLL_DAYS="Mon Thu"
