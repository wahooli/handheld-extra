# Identity of the pacman repository this project publishes.
#
# Split out because three scripts and two workflows need to agree on it, and
# because these two values are the ones that end up in every device's
# /etc/pacman.conf -- changing them later means visiting each device.

# The pacman database name. Appears as [handheld-extra] in pacman.conf.
REPO_NAME=handheld-extra

# Path within the R2 bucket. The kernel repo owns /aarch64; this one is kept
# under its own prefix so the two never share a database.
#
# That separation is the whole reason this is a second repository rather than
# more workflows in the first one: publishing is a read-modify-write on a single
# database object (download, repo-add, upload) with no locking. Two producers
# against one database silently lose whichever package was added second.
ARCH_DIR=extra/aarch64

# Where the built repo is actually served. Public information, not a secret --
# it is the URL every device has in its pacman.conf.
#
# Defaulted rather than assigned, because verify-repo.sh reads REPO_URL from the
# environment and sources this file AFTERWARDS. A plain assignment here would
# overwrite what the caller passed, so
#     REPO_URL=https://staging... scripts/verify-repo.sh
# would silently verify production instead -- the one thing that script exists
# to rule out.
REPO_URL="${REPO_URL:-https://arch-repo.wahoo.li}"
